pkgname=lidm
pkgver=2.0.2
pkgrel=13
pkgdesc='Minimal TUI display manager'
arch=(x86_64)
url=https://github.com/javalsai/lidm
license=(GPL-3.0-only)
depends=(pam)
backup=(etc/lidm.ini)

prepare() {
  rm -rf lidm
  cp -r "$startdir/lidm" .
}

build() {
  cd lidm
  make INFO_BUILD_TS="${SOURCE_DATE_EPOCH:-0}"
}

package() {
  cd lidm
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
