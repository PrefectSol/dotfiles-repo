#!/bin/bash
dir=${XDG_DATA_HOME:-$HOME/.local/share}/distro/clipboard

restore() {
	local path=$1 tmp u
	case $path in
	*.txt) xclip -selection clipboard -i "$path" ;;
	*.uri)
		tmp=$(mktemp -d)
		{ echo copy; cat "$path"; } >"$tmp/gnome"
		while IFS= read -r u; do
			u=${u#file://}
			printf '%b\n' "${u//%/\\x}"
		done <"$path" >"$tmp/paths"
		distro-clipserve text/uri-list "$path" x-special/gnome-copied-files "$tmp/gnome" \
			UTF8_STRING "$tmp/paths" text/plain "$tmp/paths"
		rm -rf "$tmp"
		;;
	*) xclip -selection clipboard -t "image/${path##*.}" -i "$path" ;;
	esac
}

if [[ $1 == restore ]]; then
	[[ -f $2 ]] && restore "$2"
	exit 0
fi
[[ -d $dir ]] || exit 0
lines=()
while IFS= read -r f; do
	path=$dir/$f
	ts=$(date -r "$path" '+%H:%M')
	case $f in
	*.txt)
		n=$(grep -c '' "$path")
		text=$(head -c 400 "$path" | tr '\n\t' '  ' | tr -s ' ' | cut -c1-110)
		((n > 1)) && text+="  [$n lines]"
		label="$ts  $text"
		;;
	*.uri)
		first=$(head -1 "$path")
		first=${first#file://}
		first=$(printf '%b' "${first//%/\\x}")
		n=$(grep -c '' "$path")
		label="$ts  [files] ${first##*/}"
		((n > 1)) && label+=" +$((n - 1))"
		;;
	*)
		size=$(file -b "$path" | grep -oE '[0-9]+ ?x ?[0-9]+' | head -1 | tr -d ' ')
		label="$ts  [img ${size:-?}]"
		;;
	esac
	lines+=("$label"$'\t'"$path")
done < <(ls -1t "$dir")
((${#lines[@]})) || exit 0
chosen=$(printf '%s\n' "${lines[@]}" | dmenu -P -l 8 -p clipboard "$@") || exit 0
path=${chosen##*$'\t'}
[[ $chosen == *$'\t'* && -f $path ]] || exit 0
restore "$path"
touch "$path"
