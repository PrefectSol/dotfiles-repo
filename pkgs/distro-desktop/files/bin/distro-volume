#!/bin/sh
sink=@DEFAULT_AUDIO_SINK@
case $1 in
up) wpctl set-volume -l 1.5 $sink 5%+ ;;
down) wpctl set-volume $sink 5%- ;;
mute) wpctl set-mute $sink toggle ;;
*) echo "usage: distro-volume up|down|mute" >&2; exit 1 ;;
esac
set -- $(wpctl get-volume $sink)
vol=$(awk -v v="$2" 'BEGIN { printf "%d", v * 100 + 0.5 }')
[ "$3" = "[MUTED]" ] && text=muted || text="$vol%"
notify-send -a volume -u low -t 1500 -h string:x-dunst-stack-tag:volume -h int:value:"$vol" volume "$text"
